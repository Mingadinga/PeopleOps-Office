# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
dev.err.log

# 로컬 환경변수는 제외하고 값이 비어 있는 예시만 커밋
.env*
!.env.example
# Cloudflare 로컬 비밀값 (예시 파일만 커밋)
.dev.vars
.dev.vars.*
!.dev.vars.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# 로컬 인증서 및 개인 키
*.key
*.p12
*.pfx

# Python 분석 환경 및 캐시 (Case JSON, CSV, Analysis JSON은 커밋)
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# build/는 Vite 플러그인 소스이므로 제외하지 않는다.
# .openai/hosting.json도 현재 빌드에 필요한 설정이므로 보존한다.
